# ── Groq ──
GROQ_API_KEY=gsk_...

# ── Server ──
HOST=127.0.0.1
PORT=8000
ENV=development

# ── Instagram (optional throwaway account for instaloader) ──
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ── Postgres (Supabase) — user accounts & saved analyses ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# ── Qdrant (vector DB) ──
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=

# ── Embeddings backend ──
# "hf"    = HuggingFace Inference API (no model in server memory; best for small hosts)
# "local" = fastembed ONNX (offline, no API calls)
EMBEDDINGS_BACKEND=hf
HF_API_TOKEN=hf_...

# ── SMTP (transactional email, e.g. Brevo) ──
SMTP_USER=
SMTP_PASSWORD=
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=you@example.com

# ── Auth ──
JWT_SECRET=generate_a_long_random_string
JWT_EXPIRE_MINUTES=10080
